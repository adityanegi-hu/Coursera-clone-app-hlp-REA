<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/button_coursera_blue"/>
            <corners android:radius="@dimen/space_small"/>
            <solid android:color="@color/state_into_background"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <stroke
                android:width="2dp"
                android:color="@color/state_danger"/>
            <corners android:radius="@dimen/space_small"/>
            <solid android:color="@color/unselected_answer_option_bg"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/button_coursera_blue"/>
            <corners android:radius="@dimen/space_small"/>
            <solid android:color="@color/state_into_background"/>
        </shape>
    </item>
    <item
        android:state_checked="false"
        android:state_selected="false">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/unselected_answer_option_border"/>
            <corners android:radius="@dimen/space_small"/>
            <solid android:color="@color/unselected_answer_option_bg"/>
        </shape>
    </item>
</selector>
