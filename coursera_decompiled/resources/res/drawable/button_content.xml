<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/divider_dark"/>
            <solid android:color="@color/divider_dark"/>
        </shape>
    </item>
    <item android:bottom="1dp">
        <selector>
            <item
                android:state_enabled="true"
                android:state_pressed="true"
                android:drawable="@color/background_zero_saturation"/>
            <item
                android:state_enabled="true"
                android:state_selected="true"
                android:drawable="@color/button_disabled"/>
            <item android:drawable="@color/text_inverted_primary"/>
        </selector>
    </item>
</layer-list>
