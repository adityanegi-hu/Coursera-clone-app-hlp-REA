<?xml version="1.0" encoding="utf-8"?>
<org.coursera.android.core.CenteredToolbar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coursera_toolbar"
    android:background="@color/background_primary"
    android:layout_width="match_parent"
    android:layout_height="?android:attr/actionBarSize"
    app:contentInsetStartWithNavigation="0dp"
    app:elevation="4dp"
    app:layout_collapseMode="pin"
    app:layout_scrollFlags="enterAlways|scroll">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textColor="@color/text_inverted_primary"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/toolbar_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:maxLines="2"
            android:lineSpacingExtra="20dp"
            android:lineSpacingMultiplier="0"
            android:layout_marginEnd="16dp"
            app:autoSizeMaxTextSize="16sp"
            app:autoSizeMinTextSize="14sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</org.coursera.android.core.CenteredToolbar>
