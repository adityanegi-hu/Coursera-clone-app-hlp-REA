<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/overlay_gray"
    android:layout_width="match_parent"
    style="@style/video_player">
    <LinearLayout
        android:orientation="horizontal"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="2"
        android:importantForAccessibility="no">
        <FrameLayout
            android:id="@+id/rewindView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:importantForAccessibility="no">
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/lottie_rewind_overlay"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                app:lottie_autoPlay="false"
                app:lottie_fileName="video_player_rewind_animation.json"
                app:lottie_imageAssetsFolder="images/"
                app:lottie_loop="false"/>
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/lottie_rewind_view"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                app:lottie_autoPlay="false"
                app:lottie_fileName="video_player_rewind_arrows.json"
                app:lottie_imageAssetsFolder="images/"
                app:lottie_loop="false"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/fastForwardView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:importantForAccessibility="no">
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/lottie_forward_overlay"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                app:lottie_autoPlay="false"
                app:lottie_fileName="video_player_forward_animation.json"
                app:lottie_imageAssetsFolder="images/"
                app:lottie_loop="false"/>
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/lottie_forward_view"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                app:lottie_autoPlay="false"
                app:lottie_fileName="video_player_forward_arrows.json"
                app:lottie_imageAssetsFolder="images/"
                app:lottie_loop="false"/>
        </FrameLayout>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/settings"
        android:padding="12dp"
        android:focusable="true"
        android:visibility="visible"
        android:layout_width="@dimen/minimum_touchable_area_dimension"
        android:layout_height="@dimen/minimum_touchable_area_dimension"
        android:layout_margin="@dimen/space_small"
        android:foreground="@drawable/focus_indicator_border"
        android:contentDescription="@string/more_options"
        android:layout_marginStart="@dimen/space_small"
        app:layout_constraintEnd_toStartOf="@+id/hide_controls_button"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_cog"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/minimize_button"
        android:focusable="true"
        android:visibility="visible"
        android:layout_width="@dimen/minimum_touchable_area_dimension"
        android:layout_height="@dimen/minimum_touchable_area_dimension"
        android:layout_margin="@dimen/space_small"
        android:foreground="@drawable/focus_indicator_border"
        android:tint="@color/text_inverted_primary_fixed"
        android:contentDescription="@string/navigate_up_button_content_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_arrow_back_16_48"
        app:tint="@color/text_inverted_primary_fixed"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/hide_controls_button"
        android:padding="12dp"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="@dimen/minimum_touchable_area_dimension"
        android:layout_height="@dimen/minimum_touchable_area_dimension"
        android:layout_margin="@dimen/space_small"
        android:foreground="@drawable/focus_indicator_border"
        android:contentDescription="@string/hide_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_hide_controls_white"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/fullscreen"
        android:padding="@dimen/icon_padding"
        android:focusable="true"
        android:layout_width="@dimen/minimum_touchable_area_dimension"
        android:layout_height="@dimen/minimum_touchable_area_dimension"
        android:layout_margin="@dimen/space_large"
        android:layout_marginTop="100dp"
        android:foreground="@drawable/focus_indicator_border"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/exo_icon_fullscreen_enter"/>
    <org.coursera.android.content_video.feature_module.view.MediaRouteButtonWhite
        android:id="@+id/castButton"
        android:layout_width="@dimen/minimum_touchable_area_dimension"
        android:layout_height="@dimen/minimum_touchable_area_dimension"
        android:layout_margin="@dimen/space_small"
        app:layout_constraintEnd_toStartOf="@+id/settings"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:theme="@style/ClickableView"
        android:id="@+id/exo_rew"
        android:padding="@dimen/icon_padding"
        android:layout_width="@dimen/minimum_touchable_area_dimension"
        android:layout_height="@dimen/minimum_touchable_area_dimension"
        android:contentDescription="@string/exo_controls_rewind_description"
        app:layout_constraintEnd_toStartOf="@+id/exo_play_pause"
        app:layout_constraintHorizontal_bias="0.6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/exo_play_pause"
        app:srcCompat="@drawable/ic_rewind_10_sec"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:theme="@style/ClickableView"
        android:id="@+id/exo_play_pause"
        android:layout_width="@dimen/minimum_touchable_area_dimension"
        android:layout_height="@dimen/minimum_touchable_area_dimension"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/exo_controls_play"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:theme="@style/ClickableView"
        android:id="@+id/exo_ffwd"
        android:padding="@dimen/icon_padding"
        android:layout_width="@dimen/minimum_touchable_area_dimension"
        android:layout_height="@dimen/minimum_touchable_area_dimension"
        android:contentDescription="@string/exo_controls_fastforward_description"
        app:layout_constraintBottom_toBottomOf="@+id/exo_rew"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.4"
        app:layout_constraintStart_toEndOf="@+id/exo_play_pause"
        app:layout_constraintTop_toTopOf="@+id/exo_rew"
        app:srcCompat="@drawable/ic_forward_10_sec"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:theme="@style/ClickableView"
        android:id="@+id/exo_subtitle_on_off"
        android:padding="@dimen/icon_padding"
        android:layout_width="@dimen/minimum_touchable_area_dimension"
        android:layout_height="@dimen/minimum_touchable_area_dimension"
        android:contentDescription="@string/closed_captions"
        android:layout_marginEnd="@dimen/space_small"
        app:layout_constraintEnd_toStartOf="@+id/castButton"
        app:layout_constraintTop_toTopOf="@+id/castButton"
        app:srcCompat="@drawable/exo_styled_controls_subtitle_off"/>
    <TextView
        android:textColor="@color/text_inverted_primary_fixed"
        android:id="@+id/exo_position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/fullscreen"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/fullscreen"/>
    <TextView
        android:textColor="@color/text_inverted_primary_fixed"
        android:id="@+id/duration_separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" / "
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/exo_position"
        app:layout_constraintStart_toEndOf="@+id/exo_position"
        app:layout_constraintTop_toTopOf="@+id/exo_position"/>
    <TextView
        android:textColor="@color/text_inverted_primary_fixed"
        android:id="@+id/exo_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/exo_position"
        app:layout_constraintStart_toEndOf="@+id/duration_separator"
        app:layout_constraintTop_toTopOf="@+id/exo_position"/>
    <org.coursera.android.content_video.custom_views.TickedTimeBar
        android:id="@+id/exo_progress"
        android:layout_width="0dp"
        android:layout_height="@dimen/size_xlarge"
        android:mirrorForRtl="false"
        app:bar_gravity="center"
        app:buffered_color="@color/player_time_bar_buffered_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:played_color="@color/button_coursera_blue"
        app:scrubber_color="@color/button_coursera_blue"
        app:scrubber_dragged_size="0dp"
        app:scrubber_enabled_size="0dp"
        app:unplayed_color="@color/player_time_bar_unplayed_color"
        style="?android:attr/progressBarStyleHorizontal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
